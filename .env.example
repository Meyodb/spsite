# Copier en .env et renseigner si besoin.
# Variables d'environnement du projet.

# ─── Back-office admin (obligatoire, le serveur refuse de démarrer sans) ──
ADMIN_USER=
# Générer avec : node server/scripts/set-admin-password.js
ADMIN_PASSWORD_HASH=
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ─── Site public ─────────────────────────────────────────────────────
# URL absolue du site : requise pour les canonicals et Open Graph.
VITE_SITE_URL=https://www.soup-juice.net

# Identifiant Google Analytics. Laisser vide pour désactiver le suivi.
# Le script n'est chargé qu'après acceptation des cookies.
VITE_GA_MEASUREMENT_ID=

# Origines autorisées par CORS en production (séparées par des virgules).
CORS_ALLOWED_ORIGINS=https://www.soup-juice.net,https://soup-juice.net

# Clé API Google Gemini (nécessaire pour le chatbot IA).
# Obtenir une clé gratuite sur https://aistudio.google.com
GEMINI_API_KEY=

# Modèle Gemini à utiliser. Par défaut : gemini-2.5-flash (gratuit, rapide)
# Autres options : gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# ─── Synchro produits JDC ────────────────────────────────────────────
# Source de vérité pour la visibilité des produits :
# un produit local dont le jdc_id est dans la liste retournée par cet endpoint
# reste actif (visible = 1), sinon il est désactivé (visible = 0).
# Les produits sans jdc_id sont également désactivés.
JDC_SYNC_ENABLED=1
JDC_PUBLIC_PRODUCTS_URL=https://kmtmwnxtnzqbynhoztks.supabase.co/functions/v1/public-products
# Optionnel : clé anon Supabase (si la fonction JDC l'exige un jour). Laisser vide sinon.
JDC_ANON_KEY=
# Intervalle de re-sync en minutes (0 = pas d'auto-refresh, uniquement au boot et via le bouton admin)
JDC_SYNC_INTERVAL_MIN=30
